{
  "name": "cybersec-password-guardian",
  "version": "3.0.0",
  "description": "Game Pixel về Độ Mạnh Mật Khẩu với 5 nút bấm Arduino và NodeJS (Hỗ trợ đa nền tảng Windows & macOS)",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "app": "electron .",
    "dist": "electron-packager . CyberSecGame --platform=win32 --arch=x64 --out=dist --overwrite --icon=icon.ico --prune=true",
    "dist:win": "electron-packager . CyberSecGame --platform=win32 --arch=x64 --out=dist --overwrite --icon=icon.ico --prune=true",
    "dist:mac": "electron-packager . CyberSecGame --platform=darwin --arch=x64,arm64 --out=dist --overwrite --icon=icon.icns --prune=true",
    "dist:mac:arm64": "electron-packager . CyberSecGame --platform=darwin --arch=arm64 --out=dist --overwrite --icon=icon.icns --prune=true",
    "dist:mac:x64": "electron-packager . CyberSecGame --platform=darwin --arch=x64 --out=dist --overwrite --icon=icon.icns --prune=true",
    "dist:all": "npm run dist:win && npm run dist:mac",
    "pack:mac:zip": "tar.exe -a -cf dist/CyberSecGame-macOS-arm64.zip -C dist/CyberSecGame-darwin-arm64 CyberSecGame.app && tar.exe -a -cf dist/CyberSecGame-macOS-x64.zip -C dist/CyberSecGame-darwin-x64 CyberSecGame.app",
    "build:dmg": "bash scripts/build-dmg.sh",
    "setup": "\"C:\\Users\\peter\\AppData\\Local\\Programs\\Inno Setup 6\\ISCC.exe\" installer.iss"
  },
  "keywords": [
    "cybersecurity",
    "password-strength",
    "arduino",
    "pixel-game",
    "nodejs",
    "electron"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "express": "^5.3.0",
    "localtunnel": "^2.0.2",
    "qrcode": "^1.5.4",
    "serialport": "^13.0.0",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-packager": "^17.1.2"
  }
}
